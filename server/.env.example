PORT=5000
NODE_ENV=development
JWT_SECRET=sweety_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Connection
# You can use a complete connection string:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_db

# Or individual parameters if preferred:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=sweety_db

# Set to true to run with an in-memory PostgreSQL engine (useful for standalone testing / environments without local Postgres)
USE_PG_MEM=false
