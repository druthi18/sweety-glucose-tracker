# ==========================================
# Sweety Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=sweety_jwt_super_secret_key_change_me
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sweety_db

# In-Memory Database Fallback (set to true for zero-setup execution or standalone tests)
USE_PG_MEM=false
